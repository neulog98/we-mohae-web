rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    function isWeddingCouple(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data.mode == "wedding";
    }

    function onlyTwoMembers() {
      return request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 2;
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (
          signedIn()
          && resource.data.coupleId is string
          && isCoupleMember(resource.data.coupleId)
        );
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /inviteCodes/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn()
        && exists(/databases/$(database)/documents/couples/$(resource.data.coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.memberIds;
    }

    match /couples/{coupleId} {
      allow get, list: if isCoupleMember(coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && onlyTwoMembers()
        && request.resource.data.mode in ["couple", "wedding"];
      allow update: if signedIn()
        && onlyTwoMembers()
        && (
          isCoupleMember(coupleId)
          || (
            resource.data.memberIds.size() == 1
            && request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds[0] in request.resource.data.memberIds
            && request.resource.data.mode == resource.data.mode
          )
        );
      allow delete: if false;

      match /schedules/{scheduleId} {
        allow read, create, update, delete: if isCoupleMember(coupleId);
      }

      match /budgets/{budgetId} {
        allow read, create, update, delete: if isCoupleMember(coupleId) && isWeddingCouple(coupleId);
      }

      match /checklist/{checklistId} {
        allow read, create, update, delete: if isCoupleMember(coupleId) && isWeddingCouple(coupleId);
      }

      match /guests/{guestId} {
        allow read, create, update, delete: if isCoupleMember(coupleId) && isWeddingCouple(coupleId);
      }

      match /vendors/{vendorId} {
        allow read, create, update, delete: if isCoupleMember(coupleId) && isWeddingCouple(coupleId);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isCoupleMember(coupleId);
        allow create, update: if isCoupleMember(coupleId)
          && request.resource.data.userId == request.auth.uid;
        allow delete: if isCoupleMember(coupleId)
          && resource.data.userId == request.auth.uid;
      }

      match /sentNotifications/{notificationId} {
        allow read: if isCoupleMember(coupleId);
        allow write: if false;
      }
    }
  }
}
