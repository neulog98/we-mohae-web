{
  "name": "woori-mwohae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/configure-firebase-sw.mjs",
    "start": "next start",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:firebase": "npm run build && firebase deploy --only hosting,firestore:rules",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "rules:test": "firebase emulators:exec --only firestore \"npm run rules:test:unit\"",
    "rules:test:unit": "vitest run tests/rules"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "firebase": "^10.14.1",
    "lucide-react": "^0.468.0",
    "next": "^14.2.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.16",
    "firebase-tools": "^13.22.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
